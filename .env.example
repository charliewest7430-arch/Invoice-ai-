# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://www.invoiceflowai.cloud).
# Used for self-referential links, payment redirects, and webhook endpoints.
APP_URL="https://www.invoiceflowai.cloud"

# Supabase Credentials
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Flutterwave LIVE / TEST Credentials
FLW_SECRET_KEY="FLWSECK_TEST-xxx"
FLW_SECRET_HASH="your_secret_webhook_hash"
VITE_FLW_PUBLIC_KEY="FLWPUBK_TEST-xxx"

# Resend Email Configuration
RESEND_API_KEY="re_xxx"
EMAIL_FROM="InvoiceFlow <no-reply@invoiceflowai.cloud>"

# TikTok Pixel Tracking
VITE_TIKTOK_PIXEL_ID="DA6B9BJC77U48103RALG"

# Billing Cron Worker Security Secret (Used by Vercel Cron or external schedulers)
CRON_SECRET="your-secure-random-cron-secret-string"

