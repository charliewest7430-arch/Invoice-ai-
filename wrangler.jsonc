{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-ai",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
